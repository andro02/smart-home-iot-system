# Copy to .env and fill in. Docker Compose creates InfluxDB and Grafana with
# these values, and server/server.py reads the token and bucket from here.
INFLUXDB_DB=iot_db
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=change-me
# any long random string, e.g. from: python -c "import secrets; print(secrets.token_urlsafe(48))"
INFLUXDB_TOKEN=change-me

GRAFANA_USERNAME=admin
GRAFANA_PASSWORD=change-me
